PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret

# Checkout maps use OpenStreetMap and do not require a map API key.

# Firebase Cloud Messaging (web push). Client values are public; credentials stay server-only.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
# Or set FIREBASE_SERVICE_ACCOUNT_JSON to the complete service-account JSON string.

# Optional WhatsApp through Twilio. Approved-template/24-hour-window rules apply.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Recommended for proactive notifications: approved content template with
# variables {{1}} (title) and {{2}} (message body).
TWILIO_WHATSAPP_CONTENT_SID=

# ========================================================
# OFFICIAL PAYMENT GATEWAYS & CREDENTIALS
# ========================================================
# JazzCash (Official Merchant Hosted Checkout / HMAC-SHA256 IPN)
JAZZCASH_MODE=sandbox
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=

# Easypaisa (Official Hosted Checkout / Token)
EASYPAISA_MODE=sandbox
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=

# Stripe (Official Card Gateway - Visa, Mastercard, AMEX)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Default Bank Transfer Details (Manual Staff Verification)
BANK_NAME=Meezan Bank Ltd.
BANK_ACCOUNT_TITLE=Restaurant Business Account
BANK_IBAN=PK00MEZN0000000000000000
BANK_ACCOUNT_NUMBER=0102030405

# Raast Instant Payment (Manual Staff Verification)
RAAST_IBAN=PK00MEZN0000000000000000
RAAST_ACCOUNT_TITLE=Restaurant Business Account
RAAST_BANK_NAME=Meezan Bank (Raast)
